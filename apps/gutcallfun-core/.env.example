DATABASE_URL=postgresql://gutcallfun:changeme-local-only@127.0.0.1:5488/gutcallfun
PORT=3000
NODE_ENV=development
WEB_APP_ORIGIN=http://localhost:3001

# Phase 3 — Wallet Auth
# Access-JWT signing secret (min 32 chars). Refresh tokens are opaque + in-memory.
JWT_ACCESS_SECRET=dev-only-change-me-access-secret-min-32-chars
# Optional overrides (seconds). Defaults: access 900 (15m), refresh 2592000 (30d).
# JWT_ACCESS_TTL=900
# JWT_REFRESH_TTL=2592000
# SIWS message domain (anti-phishing). Defaults to the WEB_APP_ORIGIN host.
# AUTH_DOMAIN=localhost
